# BLISSVOID environment configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env

# Prisma SQLite database file.
# Relative paths are resolved from prisma/schema.prisma,
# so ../db/custom.db lands at <project-root>/db/custom.db
DATABASE_URL="file:../db/custom.db"
# Master encryption key for the credential vault (minimum 32 characters; required in production)
BLISSVOID_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Runtime environment ("development" | "production" | "test")
NODE_ENV="development"
